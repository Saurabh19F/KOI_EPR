# =============================================
# ERP Environment Configuration
# Copy to .env and update values
# =============================================

# =============================================
# SUPABASE / POSTGRESQL DATABASE
# =============================================
# For Supabase, use your connection string:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# For local development:
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=your-password-here
DATABASE_URL=postgresql://postgres:your-password-here@db.your-project.supabase.co:5432/postgres

# Sync schema (development only - disable in production!)
DATABASE_SYNC=true

# =============================================
# REDIS (for caching & queues)
# =============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================
# JWT AUTHENTICATION
# =============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_EXPIRES_IN=15m

# Demo user password (for seed script)
DEMO_USER_PASSWORD=admin123

# =============================================
# APPLICATION
# =============================================
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
NODE_ENV=development

# =============================================
# MINIO / S3 STORAGE
# =============================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=erp-documents
MINIO_USE_SSL=false

# =============================================
# EMAIL (Configure for production)
# =============================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@erp.local

# =============================================
# WHATSAPP (Twilio)
# =============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# =============================================
# QUEUES (BullMQ)
# =============================================
QUEUES_ENABLED=false

# =============================================
# LOGGING
# =============================================
LOG_LEVEL=debug
