{
  "name": "erp-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "turbo": "^2.9.16",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0",
  "dependencies": {
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/platform-socket.io": "11.1.29",
    "@nestjs/websockets": "11.1.29",
    "supabase": "^2.100.1"
  },
  "overrides": {
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/platform-socket.io": "11.1.29",
    "@nestjs/websockets": "11.1.29",
    "lodash": "4.18.1",
    "qs": "6.15.3",
    "tar": "7.5.22",
    "uuid": "11.1.1",
    "@nestjs/swagger@11.4.6": {
      "js-yaml": "5.2.3"
    },
    "exceljs@4.4.0": {
      "uuid": "11.1.1"
    }
  }
}
